{
  "name": "power-platform-governance-mcp",
  "version": "1.0.0",
  "description": "MCP server that gives AI agents cited, hybrid-search answers from Microsoft's Power Platform governance docs (DLP, environments, Managed Environments, CoE Starter Kit, ALM). Works with Claude and Copilot Studio.",
  "type": "module",
  "bin": {
    "power-platform-governance-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fetch-corpus": "tsx scripts/fetch-corpus.ts",
    "build-index": "tsx scripts/build-index.ts",
    "setup": "npm run fetch-corpus && npm run build-index && npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "demo": "tsx scripts/demo.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "power-platform",
    "copilot-studio",
    "claude",
    "hybrid-search",
    "rag",
    "governance",
    "dlp"
  ],
  "author": "Kelly Jones",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
